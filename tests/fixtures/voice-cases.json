{
  "about": "Parser fixture table (src/voice/parse.ts). One final phrase in, one reading out. expect: dart notation (S/D/T + 1–20, S25 outer bull, D25 bull, M miss), 'total N', a command name, 'wake' or 'ignored'. Optional: then ('next' when a trailing next/done follows), wake (true when the phrase starts with the wake word), alt (the other reading of an ambiguous phrase, which the UI must confirm), totals (false = a mode without X01 totals; default true). Merge Voice Test Lab exports with npm run add-cases.",
  "groups": [
    {
      "name": "Darts in one phrase",
      "cases": [
        { "text": "triple twenty", "expect": "T20" },
        { "text": "triple twelve triple twelve eight", "expect": "T12 T12 S8" },
        { "text": "triple twenty triple twenty triple twenty", "expect": "T20 T20 T20" },
        { "text": "treble twenty twenty five", "expect": "T20 S20 S5" },
        { "text": "triple twenty five", "expect": "T20 S5", "note": "'twenty five' is the outer bull only as the whole phrase" },
        { "text": "double twenty five", "expect": "D20 S5", "note": "same rule, but bull is close enough to ask", "alt": "D25" },
        { "text": "single twenty five", "expect": "S20 S5", "note": "same rule" },
        { "text": "twenty five twenty", "expect": "S20 S5 S20", "note": "same rule" },
        { "text": "trip twenty dub ten", "expect": "T20 D10" },
        { "text": "single twenty double twenty miss", "expect": "S20 D20 M" },
        { "text": "triple seventeen triple eighteen bull", "expect": "T17 T18 D25" },
        { "text": "double eleven double three double one", "expect": "D11 D3 D1" },
        { "text": "four fourteen four", "expect": "S4 S14 S4" },
        { "text": "twenty one", "expect": "S20 S1", "note": "bare numbers are singles; same score as a 21 total" },
        { "text": "twenty six", "expect": "S20 S6" },
        { "text": "double sixteen", "expect": "D16" },
        { "text": "eight", "expect": "S8" },
        { "text": "twenty", "expect": "S20" },
        { "text": "one", "expect": "S1" },
        { "text": "one five", "expect": "S1 S5" },
        { "text": "single five single one triple twenty", "expect": "S5 S1 T20" },
        { "text": "doubles twelve", "expect": "D12" },
        { "text": "triples nineteen", "expect": "T19" },
        { "text": "treble one", "expect": "T1" },
        { "text": "triple twenty and twenty", "expect": "T20 S20" },
        { "text": "triple nineteen then nineteen", "expect": "T19 S19" }
      ]
    },
    {
