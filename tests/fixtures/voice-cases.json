        { "text": "bullseye", "expect": "D25" },
        { "text": "double bull", "expect": "D25" },
        { "text": "inner bull", "expect": "D25" },
        { "text": "fifty", "expect": "D25", "note": "the bull, not a 50 total" },
        { "text": "outer bull", "expect": "S25" },
        { "text": "single bull", "expect": "S25" },
        { "text": "twenty five", "expect": "S25" },
        { "text": "bull bull bull", "expect": "D25 D25 D25" },
        { "text": "outer bull twenty triple twenty", "expect": "S25 S20 T20" },
        { "text": "triple twenty bull", "expect": "T20 D25" },
        { "text": "tops", "expect": "D20" },
        { "text": "double tops", "expect": "D20", "note": "new alias" },
        { "text": "miss", "expect": "M" },
        { "text": "miss miss miss", "expect": "M M M" },
        { "text": "zero", "expect": "M" },
        { "text": "nothing", "expect": "M" },
        { "text": "out", "expect": "M" },
        { "text": "bounce out", "expect": "M" },
        { "text": "no score", "expect": "M", "note": "ends the turn: the rest are misses, like the total pad's No score (the prototype gave one miss)", "then": "next" },
        { "text": "triple twenty no score", "expect": "T20 M", "note": "at the end of a phrase it ends the turn too", "then": "next" },
        { "text": "no score twenty", "expect": "M S20", "note": "elsewhere it is one miss" }
